---
import { url } from '../utils/url';
import Logo from './Logo.astro';
import Button from './Button.astro';
import { nav } from '../data/site';
import { services, servicePath } from '../data/services';
import { hero } from '../data/home';

// Build-time paths end in .html (build.format 'preserve'); public URLs do not.
const norm = (p: string) => p.replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const path = norm(Astro.url.pathname);
const servicePaths = services.map((s) => norm(url(servicePath(s.slug))));
const isSame = (href: string) => path === norm(url(href));
const isCurrent = (href: string) =>
  href === '/' ? isSame('/') : path.startsWith(norm(url(href))) || (href === '/services/' && servicePaths.includes(path));
---
<header class="header">
  <div class="container header__inner">
    <Logo />
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', { 'has-sub': item.children }]}>
            <a href={url(item.href)} aria-current={isSame(item.href) ? 'page' : undefined} class:list={{ 'is-active': isCurrent(item.href) }}>{item.label}</a>
            {item.children && (
              <>
                <button class="nav__subtoggle" type="button" aria-expanded="false" aria-controls="nav-services" aria-label="Toggle services submenu"><span aria-hidden="true"></span></button>
                <ul id="nav-services" class="nav__sub">
                  {services.map((s) => (
                    <li><a href={url(servicePath(s.slug))} aria-current={isSame(servicePath(s.slug)) ? 'page' : undefined}>{s.name}</a></li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))}
      </ul>
      <Button href="/contact" class="nav__cta">{hero.button}</Button>
    </nav>
  </div>
</header>
