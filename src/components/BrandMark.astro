---
// Brand motif: a thumbs-up. This one component draws the mark everywhere the
// site uses it (labels, buttons, bullets, decorations), so changing the paths
// here changes it site-wide. Coloured via `currentColor`; size it with CSS on
// the passed class.
//   solid   – filled, for small and medium sizes
//   outline – line drawing, for large decorative uses
interface Props { variant?: 'solid' | 'outline'; stroke?: number; class?: string }
const { variant = 'solid', stroke = 2, class: cls } = Astro.props;

const hand = 'M34 44L49 13C51 9 57 8 61 11C65 14 66 19 65 24L61 40H82C88 40 92.5 45.5 91 51.5L83 83C82 87.500 78 90 74 90H34Z';
---
<svg class:list={['brand-mark', cls]} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  {variant === 'solid' ? (
    <g fill="currentColor">
      <rect x="8" y="44" width="18" height="46" rx="4" />
      <path d={hand} />
    </g>
  ) : (
    <g fill="none" stroke="currentColor" stroke-width={stroke} stroke-linejoin="round" stroke-linecap="round">
      <rect x="8" y="44" width="18" height="46" rx="4" />
      <path d={hand} />
    </g>
  )}
</svg>
