---
import { url } from '../utils/url';
import Eyebrow from './Eyebrow.astro';
import Heading from './Heading.astro';
import Rich from './Rich.astro';
import { teamAvatar } from '../data/images';
import { members } from '../data/team';
interface Props { eyebrow: string; heading: string; text: string }
const { eyebrow, heading, text } = Astro.props;
---
<section class="section team">
  <div class="container">
    <div class="center-head">
      <Eyebrow text={eyebrow} center />
      <Heading text={heading} />
      <Rich class="lead" text={text} />
    </div>
    <ul class="team__grid">
      {members.map((m, i) => (
        <li class="member" data-reveal>
          <div class:list={['member__photo', { 'member__photo--alt': i % 2 === 1 }]}>
            <img src={url(m.photo ?? teamAvatar)} alt={m.photo ? `${m.name}, ${m.role}` : ''} width="600" height="848" loading="lazy" decoding="async" />
          </div>
          <p class="member__name">{m.name}</p>
          <p class="member__role">{m.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
