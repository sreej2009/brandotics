---
// Brand motif: a leaf whose midrib is an upward arrow. Used everywhere the
// site needs a mark (logo, labels, buttons, bullets, decorations).
// Coloured via `currentColor`; size it with CSS on the passed class.
//   solid   – filled leaf with the arrow cut out as negative space
//   outline – line drawing, for large decorative uses
interface Props { variant?: 'solid' | 'outline'; stroke?: number; class?: string }
const { variant = 'solid', stroke = 2, class: cls } = Astro.props;

const leaf = 'M17 83C14 46 44 14 88 12C86 56 54 86 17 83Z';
// Arrow outline (stem + chevron head) used as an even-odd hole in the leaf.
const arrow = 'M25.06 71.06L59.37 36.75H45V31.25H68.75V55H63.25V40.64L28.94 74.94Z';
---
<svg class:list={['growth-mark', cls]} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  {variant === 'solid' ? (
    <>
      <path fill="currentColor" fill-rule="evenodd" d={`${leaf}${arrow}`} />
      <path fill="none" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" d="M19 81L7 93" />
    </>
  ) : (
    <g fill="none" stroke="currentColor" stroke-width={stroke} stroke-linejoin="round" stroke-linecap="round">
      <path d={leaf} />
      <path d="M7 93L17 83M27 73L66 34M45 34H66V55" />
    </g>
  )}
</svg>
