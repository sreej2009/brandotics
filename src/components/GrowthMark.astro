---
// Abstract growth symbol: a leaf whose midrib is an upward arrow, cut out of
// the leaf as negative space. Coloured via `currentColor`.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class:list={['growth-mark', cls]} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs>
    <mask id="growth-mark-cut" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
      <rect width="100" height="100" fill="#fff" />
      <g fill="none" stroke="#000" stroke-width="5.5" stroke-linejoin="miter">
        <path d="M27 73 L66 34" />
        <path d="M45 34 H66 V55" />
      </g>
    </mask>
  </defs>
  <path mask="url(#growth-mark-cut)" fill="currentColor" d="M17 83 C14 46 44 14 88 12 C86 56 54 86 17 83 Z" />
  <path fill="none" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" d="M19 81 L7 93" />
</svg>
