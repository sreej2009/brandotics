---
// Home page blog teaser: latest three posts. Hidden while there are no posts.
import Eyebrow from './Eyebrow.astro';
import Heading from './Heading.astro';
import Button from './Button.astro';
import PostCard from './PostCard.astro';
import { blog, getPosts } from '../data/blog';
const posts = (await getPosts()).slice(0, 3);
---
{posts.length > 0 && (
  <section class="section blog-teaser">
    <div class="container">
      <div class="blog-head">
        <div>
          <Eyebrow text={blog.eyebrow} />
          <Heading text={blog.heading} />
        </div>
        <div class="blog-head__aside">
          <p>{blog.intro}</p>
          <Button href="/blog/">{blog.button}</Button>
        </div>
      </div>
      <div class="grid grid--3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
)}
