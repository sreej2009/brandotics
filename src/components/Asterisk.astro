---
// Six-armed asterisk motif, drawn as one polygon so it can be filled or outlined.
interface Props { variant?: 'solid' | 'outline'; stroke?: number; class?: string }
const { variant = 'solid', stroke = 2, class: cls } = Astro.props;

const R = 46; // arm length
const a = 10; // arm half-width
const rad = (deg: number) => (deg * Math.PI) / 180;
const pt = (x: number, y: number, deg: number) => {
  const c = Math.cos(rad(deg));
  const s = Math.sin(rad(deg));
  return `${(50 + x * c - y * s).toFixed(2)},${(50 + x * s + y * c).toFixed(2)}`;
};
const points: string[] = [];
for (let k = 0; k < 6; k++) {
  const deg = k * 60 - 90;
  points.push(pt(2 * a, 0, deg - 30), pt(R, -a, deg), pt(R, a, deg));
}
---
<svg class:list={['asterisk', cls]} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  {variant === 'solid'
    ? <polygon points={points.join(' ')} fill="currentColor" />
    : <polygon points={points.join(' ')} fill="none" stroke="currentColor" stroke-width={stroke} stroke-linejoin="round" />}
</svg>
