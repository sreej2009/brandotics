---
import Rich from './Rich.astro';
import { url } from '../utils/url';
import Heading from './Heading.astro';
import Button from './Button.astro';
import BrandMark from './BrandMark.astro';
interface Props { eyebrow?: string; heading: string; text?: string; button: string; href?: string }
const { eyebrow, heading, text, button, href = '/contact' } = Astro.props;
---
<section class="cta">
  <div class="container">
    <div class="cta__box" style={`background-image:url('${url('/assets/brandotics-banner.png')}')`}>
      <BrandMark variant="outline" stroke={2.2} class="cta__deco" />
      {eyebrow && <p class="cta__eyebrow">{eyebrow}</p>}
      <Heading text={heading} />
      {text && <Rich class="cta__text" text={text} />}
      <Button href={href}>{button}</Button>
    </div>
  </div>
</section>
