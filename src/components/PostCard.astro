---
import { url } from '../utils/url';
import Photo from './Photo.astro';
import { postPath, formatDate, type Post } from '../data/blog';
interface Props { post: Post; tag?: 'h2' | 'h3' }
const { post, tag: Tag = 'h3' } = Astro.props;
const { title, category, excerpt, image, date } = post.data;
---
<article class="post-card" data-reveal>
  <div class="post-card__media">
    <Photo photo={{ src: image, alt: '' }} ratio="3 / 2" />
  </div>
  <div class="post-card__body">
    <p class="post-card__meta">
      <span class="tag">{category}</span>
      <time class="post-card__date" datetime={date.toISOString()}>{formatDate(date)}</time>
    </p>
    <Tag class="post-card__title"><a href={url(postPath(post.id))}>{title}</a></Tag>
    <p class="post-card__excerpt">{excerpt}</p>
    <span class="post-card__more" aria-hidden="true">Read More</span>
  </div>
</article>
