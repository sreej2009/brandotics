---
// Contact details and social icons from src/data/site.ts. A missing contact
// value is shown as a visibly marked placeholder instead of invented information.
import SocialIcon from './SocialIcon.astro';
import { site } from '../data/site';
interface Props { part: 'address' | 'contact' | 'social' }
const { part } = Astro.props;
const { address, email, phone } = site.contact;
---
{part === 'address' && (address ? <p>{address}</p> : <p class="tbd">Address to be added</p>)}
{part === 'contact' && (
  <>
    {email ? <p><a href={`mailto:${email}`}>{email}</a></p> : <p class="tbd">Email to be added</p>}
    {phone ? <p><a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a></p> : <p class="tbd">Phone to be added</p>}
  </>
)}
{part === 'social' && (
  <ul class="socials">
    {site.socials.map((s) => (
      <li>
        {s.href
          ? <a href={s.href} rel="noopener" target="_blank" aria-label={s.label}><SocialIcon name={s.icon} /></a>
          : <span title={s.label}><SocialIcon name={s.icon} /><span class="sr-only">{s.label}</span></span>}
      </li>
    ))}
  </ul>
)}
