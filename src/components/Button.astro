---
import { url } from '../utils/url';
import BrandMark from './BrandMark.astro';
interface Props { href: string; variant?: 'primary' | 'light'; class?: string }
const { href, variant = 'primary', class: cls } = Astro.props;
---
<a class:list={['btn', `btn--${variant}`, cls]} href={url(href)}><span><slot /></span><BrandMark class="btn__mark" /></a>
