---
import BrandMark from './BrandMark.astro';
// `tag` lets a page use the label as its main heading (the home hero uses h1).
interface Props { text: string; center?: boolean; tag?: 'p' | 'h1' }
const { text, center = false, tag: Tag = 'p' } = Astro.props;
---
<Tag class:list={['eyebrow', { 'eyebrow--center': center }]}><BrandMark class="eyebrow__mark" /><span>{text}</span></Tag>
