---
import Eyebrow from './Eyebrow.astro';
import Heading from './Heading.astro';
import GrowthMark from './GrowthMark.astro';
import { process } from '../data/home';
---
<section class="section process">
  <GrowthMark variant="outline" stroke={1.2} class="process__deco" />
  <div class="container">
    <div class="split-head">
      <div>
        <Eyebrow text={process.eyebrow} />
        <Heading text={process.heading} />
      </div>
      <p class="lead">{process.text}</p>
    </div>
    <ol class="steps">
      {process.steps.map((s, i) => (
        <li class="step" data-reveal>
          <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
