---
// Two overlapping photos, as in the reference "why us" layout.
import Photo from './Photo.astro';
import type { Photo as PhotoData } from '../data/images';
interface Props { a: PhotoData; b: PhotoData }
const { a, b } = Astro.props;
---
<div class="collage" data-reveal>
  <Photo photo={a} ratio="1 / 0.92" class="collage__a" />
  <Photo photo={b} ratio="1 / 0.93" class="collage__b" />
</div>
