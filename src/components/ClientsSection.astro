---
import { url } from '../utils/url';
// Full-width band of client logos in a bordered grid (see src/data/clients.ts).
import Eyebrow from './Eyebrow.astro';
import Heading from './Heading.astro';
import { clients } from '../data/clients';
---
<section class="clients">
  <div class="container">
    <div class="center-head">
      <Eyebrow text={clients.eyebrow} center />
      <Heading text={clients.heading} />
    </div>
    <ul class="clients__grid">
      {clients.logos.map((logo) => (
        <li class:list={['clients__cell', { 'clients__cell--plate': logo.plate }]} data-reveal>
          <img src={url(logo.src)} alt={`${logo.name} logo`} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</section>
