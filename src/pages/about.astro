---
// About page copy is taken from brandotics-content.pdf (pages 26–27).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Heading from '../components/Heading.astro';
import BrandMark from '../components/BrandMark.astro';
import Photo from '../components/Photo.astro';
import { aboutImages } from '../data/images';
import Card from '../components/Card.astro';
import Feature from '../components/Feature.astro';
import Collage from '../components/Collage.astro';
import StatsBand from '../components/StatsBand.astro';
import TeamSection from '../components/TeamSection.astro';
import CtaBox from '../components/CtaBox.astro';

const intro = [
  'At Brandotics, we combine industry experience, creative thinking, and smart digital strategies to help businesses strengthen their online presence. Our team brings valuable experience from working with reputed companies, delivering meaningful results, and understanding what it takes to grow a brand in a competitive digital world.',
  'We turn our experience into strategies that help your business reach the right audience, build trust, and achieve sustainable growth.',
];
const values = [
  { icon: 'briefcase', title: 'Experience That Matters', text: 'Our team brings practical industry knowledge and experience gained through working with reputed companies and handling real business challenges.' },
  { icon: 'users', title: 'Client-Focused Approach', text: 'We understand your goals, audience, and challenges before creating digital strategies tailored to your business needs.' },
  { icon: 'trend', title: 'Results-Driven Thinking', text: 'We focus on purposeful marketing, performance, and continuous improvement to turn digital efforts into measurable progress.' },
];
const experience = [
  'Our strength comes from the experience we bring together as a team. Working in reputed companies has helped us understand professional standards, effective workflows, client expectations, and the importance of delivering quality work.',
  'We apply these lessons to every Brandotics project, combining strategic planning, creative execution, and performance-focused thinking to help businesses stand out in a crowded digital marketplace.',
];
const cards = [
  { icon: 'compass', title: 'Industry Knowledge', text: 'Experience shaped by real-world business environments.' },
  { icon: 'target', title: 'Strategic Planning', text: 'Clear direction aligned with your business goals.' },
  { icon: 'bulb', title: 'Creative Execution', text: 'Engaging digital experiences that communicate your brand.' },
  { icon: 'gauge', title: 'Performance Focus', text: 'Decisions guided by objectives, insights, and improvement.' },
];
---
<Base title="About" description={intro[1]}>
  <PageHero title="About {a:Brandotics}" crumb="About" />

  <section class="section">
    <div class="container about-split">
      <div>
        <Eyebrow text="About Brandotics" />
        <Heading text="We {oa:Build} Brands|That {a:Move Forward.}" />
        {intro.map((p) => <p class="lead">{p}</p>)}
        <div class="features features--stack">
          {values.map((f) => <Feature {...f} />)}
        </div>
      </div>
      <div class="about-split__media" data-reveal>
        <BrandMark class="about-split__mark" />
        <Photo photo={aboutImages.main} ratio="1 / 1" eager />
        <div class="about-split__tile" aria-hidden="true"><BrandMark variant="outline" stroke={2} /></div>
      </div>
    </div>
  </section>

  <StatsBand />

  <section class="section">
    <div class="container why-split">
      <Collage a={aboutImages.experienceB} b={aboutImages.experienceA} />
      <div>
        <Eyebrow text="Our Experience. Your Advantage." />
        <Heading text="Knowledge {o:Built}|Through {a:Experience.}" />
        {experience.map((p) => <p class="lead">{p}</p>)}
      </div>
    </div>
    <div class="container">
      <div class="grid grid--4 grid--spaced">
        {cards.map((c) => <Card {...c} />)}
      </div>
    </div>
  </section>

  <TeamSection
    eyebrow="The People Behind Brandotics"
    heading="{o:Experienced Minds.}|One {a:Shared Vision.}"
    text="We are an experienced team with backgrounds in reputed companies, combining expertise in digital marketing, design, and development to help businesses grow."
  />

  <CtaBox
    heading="{o:Let's} Work {a:Together!}"
    text="Ready to take your brand to the next level? Let's combine our experience with your vision and build a digital presence that makes a difference."
    button="Get in Touch"
  />
</Base>
