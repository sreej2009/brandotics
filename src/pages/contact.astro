---
// Contact page. Title, description and contact details from Final.pdf (page 37);
// the intro copy is from the original content document. URL: /contact
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactSection from '../components/ContactSection.astro';
import FaqSection from '../components/FaqSection.astro';

const text =
  'Have a project in mind or looking to strengthen your digital presence? Let’s connect and explore how Brandotics can help your business grow with smart digital marketing strategies.';
---
<Base title="Contact Us | Brandotics Digital Marketing" description="Get in touch with Brandotics for digital marketing, SEO, web development, and creative solutions tailored to your business goals.">
  <PageHero title="Contact {a:Us}" crumb="Contact" />
  <ContactSection eyebrow={'Let’s Talk'} heading="{o:Ready to}|Grow {a:Your Brand?}" text={text} />
  <FaqSection />
</Base>
