---
import { url } from '../utils/url';
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Heading from '../components/Heading.astro';
import Button from '../components/Button.astro';
import BrandMark from '../components/BrandMark.astro';
import Photo from '../components/Photo.astro';
import Card from '../components/Card.astro';
import Feature from '../components/Feature.astro';
import StatsBand from '../components/StatsBand.astro';
import SkillBars from '../components/SkillBars.astro';
import Collage from '../components/Collage.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ChannelsSection from '../components/ChannelsSection.astro';
import ClientsSection from '../components/ClientsSection.astro';
import TeamSection from '../components/TeamSection.astro';
import ContactSection from '../components/ContactSection.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBox from '../components/CtaBox.astro';
import BlogSection from '../components/BlogSection.astro';
import Rich from '../components/Rich.astro';
import { homeSeo, hero, whatWeDo, approach, why, team, talk, cta } from '../data/home';
import { services, servicePath } from '../data/services';
import { homeImages, heroAlt } from '../data/images';
import { clients } from '../data/clients';
---
<Base title={homeSeo.title} description={homeSeo.description}>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <Eyebrow tag="h1" text={hero.eyebrow} />
        <Heading tag="h2" size="xl" text={hero.heading} />
        <Rich class="hero__text" text={hero.text} />
        <Button href="/contact">{hero.button}</Button>
      </div>
      <div class="hero__media" data-reveal>
        <BrandMark class="hero__mark" />
        <img class="hero__img" src={url('/assets/hero-man-pointing.png')} alt={heroAlt} width="1850" height="850" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container services-intro">
      <div class="grid grid--2">
        {services.map((s) => <Card icon={s.icon} title={s.name} text={s.summary} href={servicePath(s.slug)} />)}
      </div>
      <div class="services-intro__text">
        <Eyebrow text={whatWeDo.eyebrow} />
        <Heading text={whatWeDo.heading} />
        <Rich class="lead lead--cols" text={whatWeDo.text} />
        <Button href="/services/">{whatWeDo.button}</Button>
      </div>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container about-split">
      <div>
        <Eyebrow text={approach.eyebrow} />
        <Heading text={approach.heading} />
        {approach.paragraphs.map((p) => <Rich class="lead" text={p} />)}
        <div class="features">
          {approach.features.map((f) => <Feature {...f} />)}
          <div class="features__action"><Button href="/about-us">More About Us</Button></div>
        </div>
      </div>
      <div class="about-split__media" data-reveal>
        <BrandMark class="about-split__mark" />
        <Photo photo={homeImages.approach} ratio="1 / 1" />
        <div class="about-split__tile" aria-hidden="true"><BrandMark variant="outline" stroke={2} /></div>
      </div>
    </div>
  </section>

  <StatsBand />

  <section class="section">
    <div class="container why-split">
      <Collage a={homeImages.whyA} b={homeImages.whyB} />
      <div>
        <Eyebrow text={why.eyebrow} />
        <Heading text={why.heading} />
        <Rich class="lead" text={why.text} />
        <div class="features features--stack">
          {why.features.map((f) => <Feature {...f} />)}
        </div>
        <SkillBars items={why.bars} />
      </div>
    </div>
  </section>

  <ProcessSection />
  <ChannelsSection />
  {clients.confirmed && <ClientsSection />}
  <TeamSection {...team} />
  <ContactSection {...talk} />
  <FaqSection />
  <CtaBox {...cta} />
  <BlogSection />
</Base>
